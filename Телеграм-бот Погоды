def db(user_id, cities=None):
    conn = sqlite3.connect(DB)
    if cities is None:
        row = conn.execute("SELECT cities FROM users WHERE user_id=?", (user_id,)).fetchone()
        conn.close()
        return ast.literal_eval(row[0]) if row else []
    conn.execute("INSERT OR REPLACE INTO users (user_id, cities) VALUES (?, ?)", (user_id, str(cities)))
    conn.commit()
    conn.close()

def get_weather(lat, lon):
    try:
        d = requests.get(
            f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current_weather=true&windspeed_unit=ms",
            timeout=5
        ).json()["current_weather"]
        return f"{d['temperature']}°C, {WEATHER_CODES.get(d['weathercode'], '')}"
    except Exception:
        return "❌ Ошибка"

@bot.message_handler(commands=["start"])
def start(m):
    mk = types.InlineKeyboardMarkup()
    mk.add(types.InlineKeyboardButton("🌤 Открыть погоду", web_app=types.WebAppInfo(url=APP_URL)))
    bot.send_message(m.chat.id, "👋 Нажми кнопку ниже, чтобы открыть приложение:", reply_markup=mk)

@app.route("/api/cities", methods=["GET"])
def api_cities():
    cities = db(int(request.args["user_id"]))
    result = []
    for c in cities:
        w = get_weather(*CITIES[c])
        result.append({"name": c, "weather": w})
    return jsonify(result)

@app.route("/api/search", methods=["GET"])
def api_search():
    q = request.args.get("q", "").lower().strip()
    matches = sorted(c for c in CITIES if q in c.lower())[:15] if q else sorted(CITIES)[:15]
    return jsonify(matches)

@app.route("/api/add", methods=["POST"])
def api_add():
    data = request.json
    cities = db(int(data["user_id"]))
    city = data["city"]
    if city not in cities:
        cities.append(city)
        db(int(data["user_id"]), cities)
    return jsonify({"ok": True})

@app.route("/api/remove", methods=["POST"])
def api_remove():
    data = request.json
    cities = db(int(data["user_id"]))
    city = data["city"]
    if city in cities:
        cities.remove(city)
        db(int(data["user_id"]), cities)
    return jsonify({"ok": True})

